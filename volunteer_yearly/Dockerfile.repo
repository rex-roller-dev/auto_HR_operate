# Build from the Git repository root, as used by CODING/TCR pipelines:
# docker build -f volunteer_yearly/Dockerfile.repo -t volunteer-yearly:2025-2026 .
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 TZ=Asia/Shanghai
WORKDIR /app
COPY volunteer_yearly/requirements.txt .
RUN pip install --no-cache-dir --timeout 120 --retries 10 -r requirements.txt
COPY volunteer_yearly/app.py .
COPY volunteer_yearly/yearly/ ./yearly/
EXPOSE 9000
CMD ["gunicorn", "--bind", "0.0.0.0:9000", "--workers", "2", "--threads", "1", "--timeout", "900", "--access-logfile", "-", "--error-logfile", "-", "--access-logformat", "%(m)s %(U)s %(s)s", "app:app"]
