# 所有凭据只在云函数环境变量中配置，不提交真实值。
EVALUATION_SCHOOL_YEAR=2025-2026
COS_REGION=ap-guangzhou
COS_BUCKET=your-existing-bucket-1234567890
COS_PREFIX=volunteer-yearly

# 复用原项目已持久化的token.json；可与结果存储使用同一桶。
TOKEN_COS_BUCKET=your-existing-bucket-1234567890
TOKEN_COS_KEY=token/token.json
TOKEN_LOCK_KEY=token/refresh-lock.jsonl
WPS_CLIENT_ID=
WPS_CLIENT_SECRET=
WPS_BIND_CODE=
WPS_SID=
KSO_SID=
WPS_UA=

# 推荐使用SCF执行角色；本地调试时才填以下临时/访问凭据。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# 新WPS表单题目名称；也可填qid:实际题目ID，字段顺序不限。
FIELD_NAME=姓名
FIELD_STUDENT_ID=学号
FIELD_EMAIL=邮箱
FIELD_SHENZHEN=志愿深圳PDF
FIELD_IVOLUNTEER=i志愿PDF

SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SENDER_EMAIL=
SENDER_PASSWORD=
SENDER_NAME=志愿服务学年统计
AUTO_HR_BACKUP_SENDER_EMAIL=
AUTO_HR_BACKUP_SENDER_PASSWORD=

# 可选：设定后需在回调URL中附加?secret=...，或通过X-Callback-Secret请求头传入。
CALLBACK_SECRET=
TMP_ROOT=/tmp/volunteer-yearly
MAX_FILES=8
MAX_PDF_BYTES=31457280
MAX_PDF_PAGES=150
MAX_CSV_BYTES=33554432
